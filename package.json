{
  "name": "vox-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write . && cd src-tauri && cargo fmt",
    "format:check": "prettier --check . && cd src-tauri && cargo fmt -- --check",
    "format:frontend": "prettier --write .",
    "format:backend": "cd src-tauri && cargo fmt",
    "test": "vitest run src/overlay/epoch.test.ts",
    "test:keyboard": "bun src/lib/utils/keyboard.test.ts",
    "test:source-update": "bun src/components/update-checker/sourceUpdateState.test.ts",
    "test:natural-voice": "bun src/components/settings/naturalVoiceState.test.ts",
    "test:tts-engine": "bun src/components/settings/ttsEngineState.test.ts",
    "test:theme": "bun src/styles/theme.test.ts",
    "test:theme-utils": "bun src/lib/utils/theme.test.ts",
    "test:sidebar-theme": "bun src/components/sidebarTheme.test.ts",
    "test:settings-search": "bun src/components/settings/search/settingsSearch.test.ts && bun src/components/settings/search/settingsSearchIndex.test.ts && bun src/components/settings/search/settingsReveal.test.ts && bun src/components/settings/search/SettingsSearchBox.test.tsx && bun src/components/ui/collapsibleOpen.test.ts && bun src/components/ui/settingContainerAnchor.test.tsx",
    "test:settings-search:e2e": "playwright test tests/settings-search.spec.ts --reporter=line",
    "test:collapsible": "bun src/components/ui/collapsibleState.test.ts && bun src/components/ui/collapsibleGroup.test.tsx",
    "test:experimental-layout": "bun src/components/settings/experimental/experimentalLayout.test.ts",
    "test:composer-form": "bun src/components/settings/composerForm.test.ts",
    "test:converse-form": "bun src/components/settings/converseForm.test.ts",
    "test:realtime-form": "bun src/components/settings/realtimeForm.test.ts",
    "test:vault-rag": "bun src/components/settings/vaultRagForm.test.ts",
    "test:acp-agent-form": "bun src/components/settings/acpAgentForm.test.ts",
    "test:agent-jobs": "bun src/lib/agentJobs.test.ts",
    "test:tts-voices": "bun src/lib/ttsVoices.test.ts",
    "test:voice-features": "vitest run src/components/settings/voice",
    "test:scripts": "bash scripts/test-update-lock.sh && bash scripts/test-update-macos.sh && bash scripts/test-install-macos.sh",
    "test:workflow-permissions": "bun scripts/check-workflow-permissions.test.ts",
    "test:playwright": "playwright test",
    "test:playwright:ui": "playwright test --ui",
    "check:translations": "bun scripts/check-translations.ts",
    "check:workflow-permissions": "bun scripts/check-workflow-permissions.ts",
    "check:model-languages": "bun scripts/check-model-language-coverage.ts",
    "postinstall": "bun scripts/check-nix-deps.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.16",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-clipboard-manager": "~2.3.2",
    "@tauri-apps/plugin-dialog": "~2.6",
    "@tauri-apps/plugin-fs": "~2.4.4",
    "@tauri-apps/plugin-opener": "^2.5.2",
    "@tauri-apps/plugin-os": "~2.3.2",
    "@tauri-apps/plugin-process": "~2.3.1",
    "@tauri-apps/plugin-updater": "~2.10.1",
    "i18next": "^25.7.2",
    "immer": "^11.1.3",
    "lucide-react": "^0.542.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.4.1",
    "react-markdown": "^10.1.0",
    "react-select": "^5.8.0",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.1.16",
    "tauri-plugin-macos-permissions-api": "2.3.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@tauri-apps/cli": "^2.11.0",
    "@types/node": "^24.9.1",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@types/react-select": "^5.0.1",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.1",
    "eslint-plugin-i18next": "^6.1.3",
    "prettier": "^3.6.2",
    "typescript": "~5.6.3",
    "vite": "^6.4.1",
    "vitest": "^5.0.4"
  }
}
